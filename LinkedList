# Definition for singly-linked list.
# class ListNode(object):
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution(object):
    def deleteDuplicates(self, head):
        """
        :type head: Optional[ListNode]
        :rtype: Optional[ListNode]
        """

        curr = head
        dummy = ListNode(0)
        dummy.next = head
        prev = dummy
        while curr:
            if curr.next and curr.val == curr.next.val:   #jabtak duplicate values aa rhi hai unhe store karna hai, aur aage badhte rehena hai, fir prev ko direct curr.next se connect kardo, to poora duplicate group skip hojayega
                val = curr.val
                while curr and curr.val == val:
                    curr = curr.next
                prev.next= curr
            else:
                prev = curr
                curr = curr.next
        return dummy.next
