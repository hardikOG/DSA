class Solution(object):
    def backspaceCompare(self, s, t):
        """
        :type s: str
        :type t: str
        :rtype: bool
        """
        stack1 = [] #to store after processing backspaces
        stack2 = []
        for ch in s:
            if ch == "#":    
                if stack1:
                    stack1.pop() #remove char at top if backspace encountered
            else:
                stack1.append(ch)
        for ch in t:
            if ch =="#":
                if stack2:
                    stack2.pop()
            else:
                stack2.append(ch)  #append normal chars
        return stack1 == stack2


